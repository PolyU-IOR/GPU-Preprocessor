@PACKAGE_INIT@
include(CMakeFindDependencyMacro)
if(@GPUPREPROCESSOR_BUILD_LP@ OR @STATIC_CUDA@)
  find_dependency(CUDAToolkit 12)
endif()
if(@GPUPREPROCESSOR_BUILD_LP@)
  find_dependency(Threads)
endif()
if(@GPUPREPROCESSOR_NATIVE_CORE@)
  find_dependency(ZLIB)
endif()
include("${CMAKE_CURRENT_LIST_DIR}/GPUPreprocessorTargets.cmake")
set(GPUPreprocessor_lp_FOUND @GPUPREPROCESSOR_BUILD_LP@)
set(GPUPreprocessor_qp_FOUND @GPUPREPROCESSOR_BUILD_QP@)
check_required_components(GPUPreprocessor)
